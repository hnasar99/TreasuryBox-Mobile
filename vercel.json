{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'Flutter dependencies are installed by the build script'",
  "buildCommand": "bash scripts/build_web.sh",
  "outputDirectory": "build/web",
  "rewrites": [{"source": "/((?!.*\\.).*)", "destination": "/index.html"}],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Frame-Options", "value": "DENY"}
    ]},
    {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/flutter_bootstrap.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/main.dart.js", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
